# Backend API base URL (browser + server)
NEXT_PUBLIC_API_URL=http://localhost:8100
# LIFF app id from the LINE Login channel (leave empty locally)
NEXT_PUBLIC_LIFF_ID=
# "https://line.me/R/ti/p/@<your-oa-id>" — shows the "remind me in LINE" button
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=
# Local only: lets /liff work without LINE (the API accepts it only while LINE is not configured)
NEXT_PUBLIC_DEV_LIFF=1
